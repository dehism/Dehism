local function getModelMeshIDs(model)
	local detectedIDs = {}
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("MeshPart") then
			local id = descendant.MeshId:match("%d+")
			if id then detectedIDs[id] = true end
		elseif descendant:IsA("SpecialMesh") then
			local id = descendant.MeshId:match("%d+")
			if id then detectedIDs[id] = true end
		end
	end
	return detectedIDs
end

local function identifyGroundFruit(model)
	local foundIDs = getModelMeshIDs(model)
	
	for fruitName, requiredIDs in pairs(FruitMeshDB) do
		local hasAllIDs = true
		for _, reqID in ipairs(requiredIDs) do
			if not foundIDs[reqID] then
				hasAllIDs = false
				break
			end
		end
		
		if hasAllIDs then
			return fruitName .. " (Spawned)"
		end
	end
	
	return "Unknown Fruit"
end

